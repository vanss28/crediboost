{
  "manifest_version": 3,
  "name": "Crediboost",
  "version": "1.0",
  "description": "Unmasking the influence of fake reviews on the marketplace.",
  "permissions": [
    "tabs",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "host_permissions": [
    "http://127.0.0.1:5050/*"
  ]
}
